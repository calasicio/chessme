{
  "name": "chessme",
  "description": "Chessme: human-like chess move prediction via Maia2 (rapid/blitz), running locally via ONNX Runtime Web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run compile && npm run lint && npm run format:check && npm run test",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jsdom": "^30.0.0",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "onnxruntime-node": "^1.30.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.12",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.5.0",
    "chess.js": "^1.4.0",
    "onnxruntime-web": "^1.30.0"
  }
}
